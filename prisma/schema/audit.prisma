model AuditLog {
    AuditLogSid Int      @id @default(autoincrement()) @map("AuditLogSid")
    tableName   String
    recordId    String? // Use String for UUID (can also use Bytes if needed)
    operation   String
    changedAt   DateTime @default(now())
    changedBy   String? // optional
    changes     Json? // JSONB equivalent in Prisma4
    oldVal      Json?
    newVal      Json?
}

model TablePrimaryKeyMap {
    table_name  String @id // Primary key
    primary_key String // Name of the primary key column
}
