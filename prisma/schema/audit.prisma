model AuditLog {
  AuditLogSid Int      @id @default(autoincrement()) @map("AuditLogSid")
  tableName   String
  recordId    String?
  operation   String
  changedAt   DateTime @default(now()) @db.Timestamptz(6)
  changedBy   String?
  changes     Json?
  newVal      Json?
  oldVal      Json?
}

model TablePrimaryKeyMap {
  table_name  String @id
  primary_key String
}
