    companyMaster     CompanyMaster     @relation(fields: [CompanyMasterSid], references: [CompanyMasterSid])
    preCustomerMaster PreCustomerMaster @relation(fields: [PreCustomerMasterSid], references: [PreCustomerMasterSid])
    countryMaster     CountryMaster     @relation(fields: [CountryMasterSid], references: [CountryMasterSid])
}

model PackageTypeMaster {
    PackageTypeMasterSid Int       @id @default(autoincrement()) @map("PackageTypeMasterSid")
    CompanyMasterSid     Int
    PackageName          String    @db.VarChar(100)
    PackageCode          String    @db.VarChar(3)
    createdOn            DateTime  @default(now()) @db.Timestamptz(6)
    updatedOn            DateTime? @updatedAt @db.Timestamptz(6)
    deletedAt            DateTime?
    createdBy            String    @db.VarChar(100)
    updatedBy            String?   @db.VarChar(100)
    status               String?   @default("A") @db.Char(1)

    companyMaster CompanyMaster @relation(fields: [CompanyMasterSid], references: [CompanyMasterSid])
}
