model CompanyMaster {
    companyName        String               @db.VarChar(100)
    companyCode        String               @db.Char(10)
    createdBy          String               @db.VarChar(100)
    createdOn          DateTime             @default(now()) @db.Timestamptz(6)
    updatedOn          DateTime             @updatedAt @db.Timestamptz(6)
    deletedAt          DateTime?
    updatedBy          String?              @db.VarChar(100)
    addressLine1       String               @db.VarChar(500)
    addressLine2       String?              @db.VarChar(500)
    postal_code        String               @db.VarChar(10)
    webSite            String?              @db.VarChar(100)
    phoneNumber        String?              @db.VarChar(20)
    email              String?              @db.VarChar(100)
    isHo               String               @db.Char(1)
    remarks            String?              @db.VarChar(500)
    companyLogo        Bytes?
    reportLogo         Bytes?
    status             String               @db.Char(1)
    CityMasterSid      Int
    CompanyMasterSid   Int                  @id @default(autoincrement()) @map("CompanyMasterSid")
    CountryMasterSid   Int
    CurrencyMasterSid  Int
    LoginSid           Int?
    StateMasterSid     Int
    branchMaster       BranchMaster[]
    chargeMaster       ChargeMaster[]
    chargeTaxMaster    ChargeTaxMaster[]
    cityMaster         CityMaster           @relation(fields: [CityMasterSid], references: [CityMasterSid])
    countryMaster      CountryMaster        @relation(fields: [CountryMasterSid], references: [CountryMasterSid])
    currencyMaster     CurrencyMaster       @relation(fields: [CurrencyMasterSid], references: [CurrencyMasterSid])
    stateMaster        StateMaster          @relation(fields: [StateMasterSid], references: [StateMasterSid])
    departmentMaster   DepartmentMaster[]
    preCustomerMaster  PreCustomerMaster[]
    preCustomerMeeting PreCustomerMeeting[]
    userBranchMaster   UserBranchMaster[]
}

model BranchMaster {
    branchName         String               @db.VarChar(100)
    branchCode         String               @db.Char(10)
    createdOn          DateTime             @default(now()) @db.Timestamptz(6)
    updatedOn          DateTime             @updatedAt @db.Timestamptz(6)
    deletedAt          DateTime?
    createdBy          String               @db.VarChar(100)
    updatedBy          String?              @db.VarChar(100)
    taxRegistrationNo  String?              @db.VarChar(50)
    CISN               String?              @db.VarChar(50)
    addressLine1       String               @db.VarChar(500)
    addressLine2       String?              @db.VarChar(500)
    postalCode         String               @db.VarChar(10)
    webSite            String?              @db.VarChar(100)
    phoneNumber        String?              @db.VarChar(20)
    email              String?              @db.VarChar(100)
    timeZone           String?              @db.Char(6)
    remarks            String?              @db.VarChar(500)
    companyLogo        Bytes?
    reportLogo         Bytes?
    status             String               @db.Char(1)
    BranchMasterSid    Int                  @id @default(autoincrement()) @map("BranchMasterSid")
    CityMasterSid      Int
    CompanyMasterSid   Int
    CountryMasterSid   Int
    CurrencyMasterSid  Int
    LoginSid           Int?
    StateMasterSid     Int
    cityMaster         CityMaster           @relation(fields: [CityMasterSid], references: [CityMasterSid])
    company            CompanyMaster        @relation(fields: [CompanyMasterSid], references: [CompanyMasterSid])
    countryMaster      CountryMaster        @relation(fields: [CountryMasterSid], references: [CountryMasterSid])
    currencyMaster     CurrencyMaster       @relation(fields: [CurrencyMasterSid], references: [CurrencyMasterSid])
    stateMaster        StateMaster          @relation(fields: [StateMasterSid], references: [StateMasterSid])
    preCustomerMaster  PreCustomerMaster[]
    preCustomerMeeting PreCustomerMeeting[]
    userBranchMaster   UserBranchMaster[]
}

model UserMaster {
    userCode         String             @db.Char(3)
    userName         String             @db.VarChar(100)
    userEmail        String             @db.VarChar(50)
    userLogin        String             @db.VarChar(50)
    userPassword     String             @db.VarChar(100)
    isSalesperson    String             @db.Char(1)
    contactNumber    String?            @db.VarChar(20)
    department       String?            @db.VarChar(20)
    designation      String?            @db.VarChar(20)
    createdBy        String?            @db.VarChar(100)
    createdOn        DateTime           @default(now()) @db.Timestamptz(6)
    updatedOn        DateTime           @updatedAt @db.Timestamptz(6)
    deletedAt        DateTime?
    updatedBy        String?            @db.VarChar(100)
    status           String             @db.Char(1)
    CountryMasterSid Int
    LoginSid         Int?
    UserMasterSid    Int                @id @default(autoincrement()) @map("UserMasterSid")
    userBranchMaster UserBranchMaster[]
    countryMaster    CountryMaster      @relation(fields: [CountryMasterSid], references: [CountryMasterSid])
}

model UserBranchMaster {
    UserBranchMasterSid Int           @id @default(autoincrement()) @map("UserBranchMasterSid")
    UserMasterSid       Int
    CompanyMasterSid    Int
    BranchMasterSid     Int
    createdOn           DateTime      @default(now()) @db.Timestamptz(6)
    updatedOn           DateTime      @updatedAt @db.Timestamptz(6)
    deletedAt           DateTime?
    createdBy           String        @db.VarChar(100)
    updatedBy           String?       @db.VarChar(100)
    LoginSid            Int?
    status              String        @db.Char(1)
    branchMaster        BranchMaster  @relation(fields: [BranchMasterSid], references: [BranchMasterSid])
    companyMaster       CompanyMaster @relation(fields: [CompanyMasterSid], references: [CompanyMasterSid])
    userMaster          UserMaster    @relation(fields: [UserMasterSid], references: [UserMasterSid])
}

model CurrencyMaster {
    currencyCode      String          @db.Char(3)
    currencyName      String          @db.VarChar(100)
    currencyID        String          @db.Char(1)
    currencyFirstName String          @db.VarChar(50)
    currencyLastName  String          @db.VarChar(50)
    currencyRatio     Int
    amountDecimal     Int
    exchangeDecimal   Int
    createdBy         String          @db.VarChar(100)
    createdOn         DateTime        @default(now()) @db.Timestamptz(6)
    updatedOn         DateTime        @updatedAt @db.Timestamptz(6)
    deletedAt         DateTime?
    updatedBy         String?         @db.VarChar(100)
    status            String          @db.Char(1)
    CountryMasterSid  Int
    CurrencyMasterSid Int             @id @default(autoincrement()) @map("CurrencyMasterSid")
    LoginSid          Int?
    branchMaster      BranchMaster[]
    chargeMaster      ChargeMaster[]
    companyMaster     CompanyMaster[]
    countryMaster     CountryMaster   @relation(fields: [CountryMasterSid], references: [CountryMasterSid])
}

model CountryMaster {
    countryCode       String              @db.Char(2)
    countryName       String              @db.VarChar(100)
    createdOn         DateTime            @default(now()) @db.Timestamptz(6)
    updatedOn         DateTime            @updatedAt @db.Timestamptz(6)
    deletedAt         DateTime?
    createdBy         String              @db.VarChar(100)
    updatedBy         String?             @db.VarChar(100)
    status            String              @db.Char(1)
    CountryMasterSid  Int                 @id @default(autoincrement()) @map("CountryMasterSid")
    LoginSid          Int?
    branchMaster      BranchMaster[]
    cityMaster        CityMaster[]
    companyMaster     CompanyMaster[]
    currencyMaster    CurrencyMaster[]
    portMaster        PortMaster[]
    preCustomerMaster PreCustomerMaster[]
    stateMaster       StateMaster[]
    userMaster        UserMaster[]
}

model StateMaster {
    stateCode         String              @db.Char(2)
    stateName         String              @db.VarChar(100)
    stateGSTCode      String?             @db.Char(5)
    createdOn         DateTime            @default(now()) @db.Timestamptz(6)
    updatedOn         DateTime            @updatedAt @db.Timestamptz(6)
    deletedAt         DateTime?
    createdBy         String              @db.VarChar(100)
    updatedBy         String?             @db.VarChar(100)
    status            String              @db.Char(1)
    CountryMasterSid  Int
    LoginSid          Int?
    StateMasterSid    Int                 @id @default(autoincrement()) @map("StateMasterSid")
    branchMaster      BranchMaster[]
    cityMaster        CityMaster[]
    companyMaster     CompanyMaster[]
    portMaster        PortMaster[]
    PreCustomerMaster PreCustomerMaster[]
    countryMaster     CountryMaster       @relation(fields: [CountryMasterSid], references: [CountryMasterSid])
}

model CityMaster {
    cityCode          String              @db.Char(3)
    cityName          String              @db.VarChar(100)
    createdOn         DateTime            @default(now()) @db.Timestamptz(6)
    updatedOn         DateTime            @updatedAt @db.Timestamptz(6)
    deletedAt         DateTime?
    createdBy         String              @db.VarChar(100)
    updatedBy         String?             @db.VarChar(100)
    status            String              @db.Char(1)
    CityMasterSid     Int                 @id @default(autoincrement()) @map("CityMasterSid")
    CountryMasterSid  Int
    LoginSid          Int?
    StateMasterSid    Int
    branchMaster      BranchMaster[]
    countryMaster     CountryMaster       @relation(fields: [CountryMasterSid], references: [CountryMasterSid])
    stateMaster       StateMaster         @relation(fields: [StateMasterSid], references: [StateMasterSid])
    companyMaster     CompanyMaster[]
    PreCustomerMaster PreCustomerMaster[]
}

model DepartmentMaster {
    createdOn           DateTime       @default(now()) @db.Timestamptz(6)
    updatedOn           DateTime       @updatedAt @db.Timestamptz(6)
    deletedAt           DateTime?
    createdBy           String         @db.VarChar(100)
    updatedBy           String?        @db.VarChar(100)
    Status              String         @db.Char(1)
    departmentName      String         @db.VarChar(20)
    departmentCode      String         @db.VarChar(5)
    departmentType      String         @db.VarChar(10)
    ExportImport        String         @db.VarChar(6)
    FCLLCL              String         @db.VarChar(6)
    CompanyMasterSid    Int
    DepartmentMasterSid Int            @id @default(autoincrement()) @map("DepartmentMasterSid")
    LoginSid            Int?
    chargeMaster        ChargeMaster[]
    companyMaster       CompanyMaster  @relation(fields: [CompanyMasterSid], references: [CompanyMasterSid])
}

model PortMaster {
    createdOn         DateTime      @default(now()) @db.Timestamptz(6)
    updatedOn         DateTime      @updatedAt @db.Timestamptz(6)
    deletedAt         DateTime?
    createdBy         String        @db.VarChar(100)
    updatedBy         String?       @db.VarChar(100)
    status            String        @db.Char(1)
    PortCode          String        @db.VarChar(5)
    PortName          String        @db.VarChar(50)
    SectorMasterSid   Int
    TimeZone          String        @db.VarChar(10)
    EdiPortCode       String        @db.VarChar(10)
    ExportRestriction String        @db.VarChar(100)
    ImportRestriction String        @db.VarChar(100)
    PortType          String        @db.VarChar(10)
    TerminalCode      String        @db.VarChar(10)
    Remarks           String        @db.VarChar(100)
    CBMRequire        String        @db.Char(1)
    SCMTPortCode      String        @db.VarChar(10)
    CountryMasterSid  Int
    LoginSid          Int?
    PortMasterSid     Int           @id @default(autoincrement()) @map("PortMasterSid")
    StateMasterSid    Int
    countryMaster     CountryMaster @relation(fields: [CountryMasterSid], references: [CountryMasterSid])
    stateMaster       StateMaster   @relation(fields: [StateMasterSid], references: [StateMasterSid])
}

model UnitMaster {
    unitCode        String    @db.VarChar(4)
    unitName        String    @db.VarChar(100)
    jobType         String    @db.VarChar(10)
    measurementType String    @db.VarChar(10)
    createdOn       DateTime  @default(now()) @db.Timestamptz(6)
    updatedOn       DateTime  @updatedAt @db.Timestamptz(6)
    deletedAt       DateTime?
    UnitMasterSid   Int       @id @default(autoincrement()) @map("UnitMasterSid")
}

model ChargeMaster {
    chargeCode          String           @db.VarChar(5)
    chargeName          String           @db.VarChar(100)
    UOM                 Int
    createdOn           DateTime         @default(now()) @db.Timestamptz(6)
    updatedOn           DateTime         @updatedAt @db.Timestamptz(6)
    deletedAt           DateTime?
    createdBy           String           @db.VarChar(100)
    updatedBy           String?          @db.VarChar(100)
    Remarks             String           @db.VarChar(100)
    Status              String           @db.Char(1)
    ChargeGroupSid      Int
    ChargeMasterSid     Int              @id @default(autoincrement()) @map("ChargeMasterSid")
    CompanyMasterSid    Int
    CurrencyMasterSid   Int
    DepartmentMasterSid Int
    chargeGroup         ChargeGroup      @relation(fields: [ChargeGroupSid], references: [ChargeGroupSid])
    companyMaster       CompanyMaster    @relation(fields: [CompanyMasterSid], references: [CompanyMasterSid])
    currencyMaster      CurrencyMaster   @relation(fields: [CurrencyMasterSid], references: [CurrencyMasterSid])
    departmentMaster    DepartmentMaster @relation(fields: [DepartmentMasterSid], references: [DepartmentMasterSid])
}

model ChargeTaxMaster {
    HSNCode            String        @db.VarChar(10)
    description        String        @db.VarChar(100)
    TaxGroup           String        @db.VarChar(10)
    TaxRate            Decimal       @db.Decimal(4, 2)
    createdOn          DateTime      @default(now()) @db.Timestamptz(6)
    updatedOn          DateTime      @updatedAt @db.Timestamptz(6)
    deletedAt          DateTime?
    CreatedBy          String        @db.VarChar(100)
    UpdatedBy          String        @db.VarChar(100)
    Remarks            String        @db.VarChar(100)
    Status             String        @db.Char(1)
    ChargeTaxMasterSid Int           @id @default(autoincrement()) @map("ChargeTaxMasterSid")
    CompanyMasterSid   Int
    companyMaster      CompanyMaster @relation(fields: [CompanyMasterSid], references: [CompanyMasterSid])
}

model PreCustomerMaster {
    createdOn            DateTime             @default(now()) @db.Timestamptz(6)
    updatedOn            DateTime             @updatedAt @db.Timestamptz(6)
    deletedAt            DateTime?
    createdBy            String               @db.VarChar(100)
    updatedBy            String?              @db.VarChar(100)
    status               String               @db.Char(1)
    preCustomerAddress1  String               @db.VarChar(300)
    preCustomerAddress2  String?              @db.VarChar(300)
    leadAssignTo         Int
    customerType         String?              @db.VarChar(10)
    contactPerson        String               @db.VarChar(50)
    phone                String               @db.VarChar(50)
    preCustomerType      String?              @db.VarChar(10)
    leadReferredBy       String               @db.VarChar(20)
    panVat               String?              @db.VarChar(20)
    remarks              String?              @db.VarChar(500)
    BranchMasterSid      Int
    CityMasterSid        Int
    CompanyMasterSid     Int
    CountryMasterSid     Int
    PreCustomerMasterSid Int                  @id @default(autoincrement()) @map("PreCustomerMasterSid")
    StateMasterSid       Int
    preCustomerName      String               @db.VarChar(100)
    leadFrom             String               @db.VarChar(20)
    email                String               @db.VarChar(100)
    branchMaster         BranchMaster         @relation(fields: [BranchMasterSid], references: [BranchMasterSid])
    cityMaster           CityMaster           @relation(fields: [CityMasterSid], references: [CityMasterSid])
    companyMaster        CompanyMaster        @relation(fields: [CompanyMasterSid], references: [CompanyMasterSid])
    countryMaster        CountryMaster        @relation(fields: [CountryMasterSid], references: [CountryMasterSid])
    stateMaster          StateMaster          @relation(fields: [StateMasterSid], references: [StateMasterSid])
    preCustomerMeeting   PreCustomerMeeting[]
}

model PreCustomerMeeting {
    createdOn             DateTime          @default(now()) @db.Timestamptz(6)
    updatedOn             DateTime          @updatedAt @db.Timestamptz(6)
    deletedAt             DateTime?
    createdBy             String            @db.VarChar(100)
    updatedBy             String?           @db.VarChar(100)
    meetingDate           DateTime
    meetingType           String            @db.VarChar(10)
    leadAssignTo          Int
    meetingStatus         String            @db.Char(1)
    customerProfile       String            @db.VarChar(100)
    remarks               String?           @db.VarChar(100)
    status                String            @db.VarChar(10)
    BranchMasterSid       Int
    CompanyMasterSid      Int
    LoginSid              Int?
    PreCustomerMasterSid  Int
    PreCustomerMeetingSid Int               @id @default(autoincrement()) @map("PreCustomerMeetingSid")
    followUpDate          DateTime?
    followUpNote          String?           @db.VarChar(100)
    meetingNote           String?           @db.VarChar(100)
    branchMaster          BranchMaster      @relation(fields: [BranchMasterSid], references: [BranchMasterSid])
    companyMaster         CompanyMaster     @relation(fields: [CompanyMasterSid], references: [CompanyMasterSid])
    preCustomerMaster     PreCustomerMaster @relation(fields: [PreCustomerMasterSid], references: [PreCustomerMasterSid])
}

model ChargeGroup {
    createdOn      DateTime       @default(now()) @db.Timestamptz(6)
    updatedOn      DateTime       @updatedAt @db.Timestamptz(6)
    deletedAt      DateTime?
    createdBy      String         @db.VarChar(100)
    updatedBy      String?        @db.VarChar(100)
    status         String         @db.Char(1)
    ChargeGroupSid Int            @id @default(autoincrement()) @map("ChargeGroupSid")
    chargeMaster   ChargeMaster[]
}

model SectorMaster {
    sectorName      String    @db.VarChar(50)
    createdOn       DateTime  @default(now()) @db.Timestamptz(6)
    updatedOn       DateTime  @updatedAt @db.Timestamptz(6)
    deletedAt       DateTime?
    createdBy       String    @db.VarChar(100)
    updatedBy       String?   @db.VarChar(100)
    status          String    @db.Char(1)
    LoginSid        Int?
    SectorMasterSid Int       @id @default(autoincrement()) @map("SectorMasterSid")
}
