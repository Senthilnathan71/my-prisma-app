model CompanyMaster {
    id               Int       @id @default(autoincrement()) // Primary key
    companyName      String    @db.VarChar(100)
    companyCode      String    @db.Char(10)
    createdBy        String    @db.VarChar(100)
    createdOn        DateTime  @default(now()) @db.Timestamptz()
    updatedOn        DateTime  @updatedAt @db.Timestamptz()
    deletedAt        DateTime?
    updatedBy        String?   @db.VarChar(100)
    loginId          Int?
    cityMasterId     Int
    countryMasterId  Int
    stateMasterId    Int
    currencyMasterId Int
    addressLine1     String    @db.VarChar(500)
    addressLine2     String?   @db.VarChar(500)
    postal_code      String    @db.VarChar(10)
    webSite          String?   @db.VarChar(100)
    phoneNumber      String?   @db.VarChar(20)
    email            String?   @db.VarChar(100)
    isHo             String    @db.Char(1)
    remarks          String?   @db.VarChar(500)
    companyLogo      Bytes?
    reportLogo       Bytes?
    status           String    @db.Char(1)

    cityMaster     CityMaster     @relation(fields: [cityMasterId], references: [id])
    stateMaster    StateMaster    @relation(fields: [stateMasterId], references: [id])
    countryMaster  CountryMaster  @relation(fields: [countryMasterId], references: [id])
    currencyMaster CurrencyMaster @relation(fields: [currencyMasterId], references: [id])

    branchMaster       BranchMaster[]
    chargeTaxMaster    ChargeTaxMaster[]
    departmentMaster   DepartmentMaster[]
    chargeMaster       ChargeMaster[]
    preCustomerMaster  PreCustomerMaster[]
    preCustomerMeeting PreCustomerMeeting[]
}

model BranchMaster {
    id              Int       @id @default(autoincrement()) // Assuming a primary key
    branchName      String    @db.VarChar(100)
    branchCode      String    @db.Char(10)
    companyMasterId Int
    createdOn       DateTime  @default(now()) @db.Timestamptz()
    updatedOn       DateTime  @updatedAt @db.Timestamptz()
    deletedAt       DateTime?

    createdBy         String  @db.VarChar(100)
    updatedBy         String? @db.VarChar(100)
    loginId           Int?
    cityMasterId      Int
    countryMasterId   Int
    stateMasterId     Int
    currencyMasterId  Int
    taxRegistrationNo String? @db.VarChar(50)
    CISN              String? @db.VarChar(50)
    addressLine1      String  @db.VarChar(500)
    addressLine2      String? @db.VarChar(500)
    postalCode        String  @db.VarChar(10)
    webSite           String? @db.VarChar(100)
    phoneNumber       String? @db.VarChar(20)
    email             String? @db.VarChar(100)
    timeZone          String? @db.Char(6)
    remarks           String? @db.VarChar(500)
    companyLogo       Bytes?
    reportLogo        Bytes?
    status            String  @db.Char(1)

    company        CompanyMaster  @relation(fields: [companyMasterId], references: [id])
    cityMaster     CityMaster     @relation(fields: [cityMasterId], references: [id])
    stateMaster    StateMaster    @relation(fields: [stateMasterId], references: [id])
    countryMaster  CountryMaster  @relation(fields: [countryMasterId], references: [id])
    currencyMaster CurrencyMaster @relation(fields: [currencyMasterId], references: [id])

    preCustomerMaster  PreCustomerMaster[]
    preCustomerMeeting PreCustomerMeeting[]
}

model UserMaster {
    id              Int       @id @default(autoincrement()) // Primary key
    userCode        String    @db.Char(3)
    userName        String    @db.VarChar(100)
    userEmail       String    @db.VarChar(50)
    userLogin       String    @db.VarChar(50)
    userPassword    String    @db.VarChar(20)
    countryMasterId Int
    isSalesperson   String    @db.Char(1)
    contactNumber   String?   @db.VarChar(20)
    department      String?   @db.VarChar(20)
    designation     String?   @db.VarChar(20)
    createdBy       String    @db.VarChar(100)
    createdOn       DateTime  @default(now()) @db.Timestamptz()
    updatedOn       DateTime  @updatedAt @db.Timestamptz()
    deletedAt       DateTime?
    updatedBy       String?   @db.VarChar(100)
    loginId         Int?
    status          String    @db.Char(1)

    countryMaster CountryMaster @relation(fields: [countryMasterId], references: [id])
}

model CurrencyMaster {
    id                Int       @id @default(autoincrement()) // Primary key
    currencyCode      String    @db.Char(3)
    currencyName      String    @db.VarChar(100)
    currencyID        String    @db.Char(1)
    currencyFirstName String    @db.VarChar(50)
    currencyLastName  String    @db.VarChar(50)
    currencyRatio     Int
    amountDecimal     Int
    exchangeDecimal   Int
    countryMasterId   Int
    createdBy         String    @db.VarChar(100)
    createdOn         DateTime  @default(now()) @db.Timestamptz()
    updatedOn         DateTime  @updatedAt @db.Timestamptz()
    deletedAt         DateTime?
    updatedBy         String    @db.VarChar(100)
    loginId           Int?
    status            String    @db.Char(1)

    countryMaster CountryMaster @relation(fields: [countryMasterId], references: [id])

    chargeMaster  ChargeMaster[]
    companyMaster CompanyMaster[]
    branchMaster  BranchMaster[]
}

model CountryMaster {
    id                Int                 @id @default(autoincrement()) // Primary key
    countryCode       String              @db.Char(2)
    countryName       String              @db.VarChar(100)
    loginId           Int?
    createdOn         DateTime            @default(now()) @db.Timestamptz()
    updatedOn         DateTime            @updatedAt @db.Timestamptz()
    deletedAt         DateTime?
    createdBy         String              @db.VarChar(100)
    updatedBy         String              @db.VarChar(100)
    status            String              @db.Char(1)
    stateMaster       StateMaster[]
    cityMaster        CityMaster[]
    companyMaster     CompanyMaster[]
    branchMaster      BranchMaster[]
    userMaster        UserMaster[]
    currencyMaster    CurrencyMaster[]
    portMaster        PortMaster[]
    preCustomerMaster PreCustomerMaster[]
}

model StateMaster {
    id              Int       @id @default(autoincrement()) // Primary key
    stateCode       String    @db.Char(2)
    stateName       String    @db.VarChar(100)
    stateGSTCode    String    @db.Char(5)
    countryMasterId Int
    loginId         Int?
    createdOn       DateTime  @default(now()) @db.Timestamptz()
    updatedOn       DateTime  @updatedAt @db.Timestamptz()
    deletedAt       DateTime?
    createdBy       String    @db.VarChar(100)
    updatedBy       String    @db.VarChar(100)
    status          String    @db.Char(1)

    countryMaster     CountryMaster       @relation(fields: [countryMasterId], references: [id])
    cityMaster        CityMaster[]
    companyMaster     CompanyMaster[]
    branchMaster      BranchMaster[]
    portMaster        PortMaster[]
    PreCustomerMaster PreCustomerMaster[]
}

model CityMaster {
    id              Int       @id @default(autoincrement()) // Primary key
    cityCode        String    @db.Char(2)
    cityName        String    @db.VarChar(100)
    stateMasterId   Int
    countryMasterId Int
    loginId         Int?
    createdOn       DateTime  @default(now()) @db.Timestamptz()
    updatedOn       DateTime  @updatedAt @db.Timestamptz()
    deletedAt       DateTime?
    createdBy       String    @db.VarChar(100)
    updatedBy       String    @db.VarChar(100)
    status          String    @db.Char(1)

    countryMaster CountryMaster @relation(fields: [countryMasterId], references: [id])
    stateMaster   StateMaster   @relation(fields: [stateMasterId], references: [id])

    companyMaster     CompanyMaster[]
    branchMaster      BranchMaster[]
    PreCustomerMaster PreCustomerMaster[]
}

model DepartmentMaster {
    id              Int       @id @default(autoincrement()) // Primary key
    createdOn       DateTime  @default(now()) @db.Timestamptz()
    updatedOn       DateTime  @updatedAt @db.Timestamptz()
    deletedAt       DateTime?
    createdBy       String    @db.VarChar(100)
    updatedBy       String    @db.VarChar(100)
    loginId         Int?
    Status          String    @db.Char(1)
    companyMasterId Int
    departmentName  String    @db.VarChar(20)
    departmentCode  String    @db.VarChar(5)
    departmentType  String    @db.VarChar(10)
    ExportImport    String    @db.VarChar(6)
    FCLLCL          String    @db.VarChar(6)

    companyMaster CompanyMaster @relation(fields: [companyMasterId], references: [id])

    chargeMaster ChargeMaster[]
}

model PortMaster {
    id                Int       @id @default(autoincrement()) // Primary key
    createdOn         DateTime  @default(now()) @db.Timestamptz()
    updatedOn         DateTime  @updatedAt @db.Timestamptz()
    deletedAt         DateTime?
    createdBy         String    @db.VarChar(100)
    updatedBy         String    @db.VarChar(100)
    loginId           Int?
    status            String    @db.Char(1)
    PortCode          String    @db.VarChar(5)
    PortName          String    @db.VarChar(50)
    countryMasterId   Int
    stateMasterId     Int
    SectorMasterSid   Int
    TimeZone          String    @db.VarChar(10)
    EdiPortCode       String    @db.VarChar(10)
    ExportRestriction String    @db.VarChar(100)
    ImportRestriction String    @db.VarChar(100)
    PortType          String    @db.VarChar(10)
    TerminalCode      String    @db.VarChar(10)
    Remarks           String    @db.VarChar(100)
    CBMRequire        String    @db.Char(1)
    SCMTPortCode      String    @db.VarChar(10)

    countryMaster CountryMaster @relation(fields: [countryMasterId], references: [id])
    stateMaster   StateMaster   @relation(fields: [stateMasterId], references: [id])
}

model UnitMaster {
    id              Int       @id @default(autoincrement()) // Primary key
    unitCode        String    @db.VarChar(4)
    unitName        String    @db.VarChar(100)
    jobType         String    @db.VarChar(10)
    measurementType String    @db.VarChar(10)
    createdOn       DateTime  @default(now()) @db.Timestamptz()
    updatedOn       DateTime  @updatedAt @db.Timestamptz()
    deletedAt       DateTime?
}

model ChargeMaster {
    id                 Int       @id @default(autoincrement()) // Primary key
    chargeCode         String    @db.VarChar(5)
    chargeName         String    @db.VarChar(100)
    departmentMasterId Int
    UOM                Int
    currencyMasterId   Int
    chargeGroupId      Int
    companyMasterId    Int
    createdOn          DateTime  @default(now()) @db.Timestamptz()
    updatedOn          DateTime  @updatedAt @db.Timestamptz()
    deletedAt          DateTime?
    createdBy          String    @db.VarChar(100)
    updatedBy          String    @db.VarChar(100)
    Remarks            String    @db.VarChar(100)
    Status             String    @db.Char(1)

    companyMaster    CompanyMaster    @relation(fields: [companyMasterId], references: [id])
    CurrencyMasterId CurrencyMaster   @relation(fields: [currencyMasterId], references: [id])
    departmentMaster DepartmentMaster @relation(fields: [departmentMasterId], references: [id])
    chargeGroup      ChargeGroup      @relation(fields: [chargeGroupId], references: [id])
}

model ChargeTaxMaster {
    id              Int       @id @default(autoincrement()) // Primary key
    HSNCode         String    @db.VarChar(10)
    description     String    @db.VarChar(100)
    TaxGroup        String    @db.VarChar(10)
    TaxRate         Decimal   @db.Decimal(4, 2)
    companyMasterId Int
    createdOn       DateTime  @default(now()) @db.Timestamptz()
    updatedOn       DateTime  @updatedAt @db.Timestamptz()
    deletedAt       DateTime?
    CreatedBy       String    @db.VarChar(100)
    UpdatedBy       String    @db.VarChar(100)
    Remarks         String    @db.VarChar(100)
    Status          String    @db.Char(1)

    companyMaster CompanyMaster @relation(fields: [companyMasterId], references: [id])
}

model PreCustomerMaster {
    id                  Int       @id @default(autoincrement()) // Primary key
    companyMasterId     Int
    branchMasterId      Int
    createdOn           DateTime  @default(now()) @db.Timestamptz()
    updatedOn           DateTime  @updatedAt @db.Timestamptz()
    deletedAt           DateTime?
    createdBy           String    @db.VarChar(100)
    updatedBy           String    @db.VarChar(100)
    status              String    @db.Char(1)
    preCustomerAddress1 String    @db.VarChar(300)
    preCustomerAddress2 String    @db.VarChar(300)
    leadAssignTo        Int
    customerType        String    @db.VarChar(10)
    cityMasterId        Int
    countryMasterId     Int
    stateMasterId       Int
    contactPerson       String    @db.VarChar(50)
    eMail               String    @db.VarChar(100)
    phone               String    @db.VarChar(50)
    preCustomerType     String    @db.VarChar(10)
    leadReferredOn      String    @db.VarChar(20)
    leadReferredBy      String    @db.VarChar(20)
    panVat              String    @db.VarChar(20)
    remarks             String    @db.VarChar(500)

    companyMaster CompanyMaster @relation(fields: [companyMasterId], references: [id])
    branchMaster  BranchMaster  @relation(fields: [branchMasterId], references: [id])
    cityMaster    CityMaster    @relation(fields: [cityMasterId], references: [id])
    stateMaster   StateMaster   @relation(fields: [stateMasterId], references: [id])
    countryMaster CountryMaster @relation(fields: [countryMasterId], references: [id])

    preCustomerMeeting PreCustomerMeeting[]
}

model PreCustomerMeeting {
    id                  Int       @id @default(autoincrement()) // Primary key
    companyMasterId     Int
    branchMasterId      Int
    createdOn           DateTime  @default(now()) @db.Timestamptz()
    updatedOn           DateTime  @updatedAt @db.Timestamptz()
    deletedAt           DateTime?
    createdBy           String    @db.VarChar(100)
    updatedBy           String    @db.VarChar(100)
    loginId             Int?
    preCustomerMasterId Int
    meetingDate         DateTime?
    meetingType         String    @db.VarChar(10)
    leadAssignTo        Int
    meetingStatus       String    @db.VarChar(10)
    customerProfile     String    @db.VarChar(100)
    followupDate        DateTime?
    remarks             String    @db.VarChar(100)
    status              String    @db.VarChar(10)

    companyMaster     CompanyMaster     @relation(fields: [companyMasterId], references: [id])
    branchMaster      BranchMaster      @relation(fields: [branchMasterId], references: [id])
    preCustomerMaster PreCustomerMaster @relation(fields: [preCustomerMasterId], references: [id])
}

model ChargeGroup {
    id        Int       @id @default(autoincrement()) // Primary key
    createdOn DateTime  @default(now()) @db.Timestamptz()
    updatedOn DateTime  @updatedAt @db.Timestamptz()
    deletedAt DateTime?
    createdBy String    @db.VarChar(100)
    updatedBy String    @db.VarChar(100)
    status    String    @db.Char(1)

    chargeMaster ChargeMaster[]
}

model SectorMaster {
    id         Int       @id @default(autoincrement()) // Primary key
    sectorName String    @db.VarChar(50)
    createdOn  DateTime  @default(now()) @db.Timestamptz()
    updatedOn  DateTime  @updatedAt @db.Timestamptz()
    deletedAt  DateTime?
    createdBy  String    @db.VarChar(100)
    updatedBy  String    @db.VarChar(100)
    loginId    Int?
    status     String    @db.Char(1)
}
