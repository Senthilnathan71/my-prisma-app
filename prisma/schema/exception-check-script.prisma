model ExceptionCheckScript {
  ExceptionCheckScriptSid  Int       @id @default(autoincrement())
  CreatedOn                DateTime  @default(now()) @db.Timestamptz(6)
  CreatedBy                String    @db.VarChar(100)
  UpdatedOn                DateTime  @default(now()) @db.Timestamptz(6)
  UpdatedBy                String?   @db.VarChar(100)
  Status                   String    @default("A") @db.Char(1)

  ScriptName               String    @db.VarChar(200)
  ScriptDescription        String?   @db.VarChar(2000)
  ScriptText               String    @db.Text

  ExecutionMode            String    @db.VarChar(10)

  Frequency                String?   @db.VarChar(10)
  DayOfWeek                Int?
  DayOfMonth               Int?
  ScheduleTime             String?   @db.VarChar(5)
  TimeZone                 String?   @db.VarChar(50)
  ToEmails                 String?   @db.VarChar(1000)
  CcEmails                 String?   @db.VarChar(1000)

  IsActive                 Boolean   @default(true)
  LastRunAt                DateTime? @db.Timestamptz(6)
  LastRunStatus            String?   @db.VarChar(20)
  LastRunMessage           String?   @db.VarChar(500)

  Runs                     ExceptionCheckScriptRun[]

  @@index([Status])
  @@index([IsActive])
  @@index([ExecutionMode])
}

model ExceptionCheckScriptRun {
  ExceptionCheckScriptRunSid  Int                  @id @default(autoincrement())
  ExceptionCheckScriptSid     Int
  Script                      ExceptionCheckScript @relation(fields: [ExceptionCheckScriptSid], references: [ExceptionCheckScriptSid], onDelete: Cascade)

  ExecutedOn                  DateTime @default(now()) @db.Timestamptz(6)
  ExecutedBy                  String   @db.VarChar(100)
  ExecutionMode               String   @db.VarChar(10)

  Status                      String   @db.VarChar(20)
  RowCount                    Int?
  DurationMs                  Int?
  ErrorMessage                String?  @db.VarChar(2000)
  EmailSentTo                 String?  @db.VarChar(1000)

  @@index([ExceptionCheckScriptSid, ExecutedOn(sort: Desc)])
  @@index([Status])
}
