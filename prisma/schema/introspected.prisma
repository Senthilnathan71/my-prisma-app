view vDepartmentIndexPage {
  CompanyMasterSid    Int?
  DepartmentMasterSid Int     @unique
  departmentName      String? @db.VarChar(20)
  departmentCode      String? @db.VarChar(5)
  departmentType      String? @db.VarChar(10)
  ExportImport        String? @db.VarChar(6)
  FCLLCL              String? @db.VarChar(6)
  Division            String? @db.VarChar(20)
  Status              String? @db.Char(1)
}

view vDepartmentLookup {
  unique_id           Int     @unique
  CompanyMasterSid    Int?
  DepartmentMasterSid Int?
  departmentName      String? @db.VarChar(20)
  departmentCode      String? @db.VarChar(5)
  departmentType      String? @db.VarChar(10)
  ExportImport        String? @db.VarChar(6)
  FCLLCL              String? @db.VarChar(6)
}

view vMasterJobIndexPage {
  MasterJobSid     Int       @unique
  CompanyMasterSid Int?
  BranchMasterSid  Int?
  departmentName   String?   @db.VarChar(20)
  departmentType   String?   @db.VarChar(10)
  MasterJobNumber  String?   @db.VarChar(100)
  MasterJobDate    DateTime? @db.Date
  MBLNo            String?   @db.VarChar(20)
  MBLDate          DateTime? @db.Date
  POL              String?   @db.VarChar(100)
  POD              String?   @db.VarChar(100)
  FDC              String?   @db.VarChar(100)
  NoOfContainers   Int?
  NoOfHouses       Int?
  Status           String?   @db.Char(1)
}

view vBookingARAP {
  CompanyMasterSid Int?
  BookingHeaderSid Int       @unique
  VoucherHeaderSid Int?       
  VoucherNumber    String?   @db.VarChar(20)
  VoucherDate      DateTime? @db.Timestamp(6)
  HBLNo            String?   @db.VarChar(200)
  DocumentTypeCode String?   @db.VarChar(5)
  CurrencyCode     String?   @db.Char(3)
  Amount           Decimal?  @db.Decimal(15, 3)
  LocalAmount      Decimal?  @db.Decimal(15, 3)
  PostStatus       String?   @db.Char(1)
}

view vHouseARAP {
  CompanyMasterSid Int?
  HouseJobSid      Int       @unique
  VoucherHeaderSid Int?
  VoucherNumber    String?   @db.VarChar(20)
  VoucherDate      DateTime? @db.Timestamp(6)
  HBLNo            String?   @db.VarChar(200)
  DocumentTypeCode String?   @db.VarChar(5)
  CurrencyCode     String?   @db.Char(3)
  Amount           Decimal?  @db.Decimal
  LocalAmount      Decimal?  @db.Decimal
  PostStatus       String?   @db.Char(1)
}

view vMasterARAP {
  CompanyMasterSid Int?
  MasterJobSid     Int       @unique
  VoucherHeaderSid Int?
  VoucherNumber    String?   @db.VarChar(20)
  VoucherDate      DateTime? @db.Timestamp(6)
  MBLNo            String?   @db.VarChar(20)
  DocumentTypeCode String?   @db.VarChar(5)
  CurrencyCode     String?   @db.Char(3)
  Amount           Decimal?  @db.Decimal
  LocalAmount      Decimal?  @db.Decimal
  PostStatus       String?   @db.Char(1)
