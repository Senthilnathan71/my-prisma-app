model ModuleMaster {
  ModuleMasterSid Int          @id @default(autoincrement()) @map("ModuleMasterSid")
  ModuleName      String       @db.VarChar(20)
  createdOn       DateTime     @default(now()) @db.Timestamptz(6)
  updatedOn       DateTime?    @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime?
  createdBy       String       @db.VarChar(100)
  updatedBy       String?      @db.VarChar(100)
  status          String?      @default("A") @db.Char(1)
  Remarks         String?      @db.VarChar(300)
  ModuleCode      String       @db.VarChar(20)
  icon            String?      @db.VarChar(30)
  menuMaster      MenuMaster[]
}

model UserRoleMaster {
  UserRoleMasterSid    Int                @id @default(autoincrement()) @map("UserRoleMasterSid")
  UserMasterSid        Int
  RoleMasterSid        Int
  createdOn            DateTime           @default(now()) @db.Timestamptz(6)
  updatedOn            DateTime?          @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime?
  createdBy            String             @db.VarChar(100)
  updatedBy            String?            @db.VarChar(100)
  status               String?            @default("A") @db.Char(1)
  Remarks              String?            @db.VarChar(300)
  GiveAccess           String?            @default("N") @db.Char(1)
  IsDefault            String?            @default("N") @db.Char(1)
  MenuMasterSid        Int?
  UserCompanyMasterSid Int?
  menuMaster           MenuMaster?        @relation(fields: [MenuMasterSid], references: [MenuMasterSid])
  roleMaster           RoleMaster         @relation(fields: [RoleMasterSid], references: [RoleMasterSid])
  userCompanyMaster    UserCompanyMaster? @relation(fields: [UserCompanyMasterSid], references: [UserCompanyMasterSid])
  userMaster           UserMaster         @relation(fields: [UserMasterSid], references: [UserMasterSid])
}

model MenuMaster {
  MenuMasterSid           Int                        @id @default(autoincrement()) @map("MenuMasterSid")
  MenuCode                String                     @db.Char(3)
  MenuName                String                     @db.VarChar(50)
  ModuleMasterSid         Int
  ModuleName              String                     @db.VarChar(50)
  createdOn               DateTime                   @default(now()) @db.Timestamptz(6)
  updatedOn               DateTime?                  @updatedAt @db.Timestamptz(6)
  deletedAt               DateTime?
  createdBy               String                     @db.VarChar(100)
  updatedBy               String?                    @db.VarChar(100)
  status                  String?                    @default("A") @db.Char(1)
  Remarks                 String?                    @db.VarChar(300)
  icon                    String?                    @db.VarChar(50)
  path                    String?                    @db.VarChar(50)
  parentId                Int?
  AttachDocumentGroup     AttachDocumentGroup[]
  authorityMaster         AuthorityMaster[]
  bookingHeader           BookingHeader[]
  costRevenueCharges      CostRevenueCharges[]
  customerBrEmail         CustomerBrEmail[]
  enquiryHeader           EnquiryHeader[]
  houseJob                HouseJob[]
  MailConfigurationMaster MailConfigurationMaster[]
  MasterJob               MasterJob[]
  menuConfig              MenuConfig[]
  moduleMaster            ModuleMaster               @relation(fields: [ModuleMasterSid], references: [ModuleMasterSid])
  menuPermission          MenuPermission[]
  quoteHeader             QuoteHeader[]
  refDocument             RefDocument[]
  ReportMaster            ReportMaster[]
  RoleMenuDetail          RoleMenuDetail[]
  roleMenuMaster          RoleMenuMaster[]
  terms                   TermsAndConditionsMaster[]
  userRoleMaster          UserRoleMaster[]
  voucherTypeMaster       VoucherTypeMaster[]
  numberSeriesConfig      NumberSeriesConfig[]
  numberSeriesCounter     NumberSeriesCounter[]
  PrintMaster             PrintMaster[]
}

model MenuPermission {
  MenuPermissionSid Int        @id @default(autoincrement()) @map("MenuPermissionSid")
  MenuMasterSid     Int
  createdOn         DateTime   @default(now()) @db.Timestamptz(6)
  updatedOn         DateTime?  @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime?
  createdBy         String     @db.VarChar(100)
  updatedBy         String?    @db.VarChar(100)
  permissionCode    String?    @db.VarChar(100)
  permissionName    String     @db.VarChar(100)
  status            String?    @default("A") @db.Char(1)
  menuMaster        MenuMaster @relation(fields: [MenuMasterSid], references: [MenuMasterSid])

  @@index([MenuMasterSid])
}

model RoleMaster {
  RoleMasterSid    Int              @id @default(autoincrement()) @map("RoleMasterSid")
  UserRoleCode     String           @db.Char(3)
  UserRoleName     String           @db.VarChar(50)
  CompanyMasterSid Int?
  createdOn        DateTime         @default(now()) @db.Timestamptz(6)
  updatedOn        DateTime?        @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?
  createdBy        String           @db.VarChar(100)
  updatedBy        String?          @db.VarChar(100)
  status           String?          @default("A") @db.Char(1)
  Remarks          String?          @db.VarChar(300)
  LicenseType      String?          @db.VarChar(50)
  companyMaster    CompanyMaster?   @relation(fields: [CompanyMasterSid], references: [CompanyMasterSid])
  RoleMenuHeader   RoleMenuHeader[]
  roleMenuMaster   RoleMenuMaster[]
  userRoleMaster   UserRoleMaster[]
}

model RoleMenuMaster {
  RoleMenuMasterSid Int            @id @default(autoincrement()) @map("RoleMenuMasterSid")
  RoleMasterSid     Int
  MenuMasterSid     Int
  CompanyMasterSid  Int?
  InsertRole        String?        @default("Y") @db.Char(1)
  ViewRole          String?        @default("Y") @db.Char(1)
  UpdateRole        String?        @default("Y") @db.Char(1)
  DeleteRole        String?        @default("N") @db.Char(1)
  createdOn         DateTime       @default(now()) @db.Timestamptz(6)
  updatedOn         DateTime?      @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime?
  createdBy         String         @db.VarChar(100)
  updatedBy         String?        @db.VarChar(100)
  status            String?        @default("A") @db.Char(1)
  Module            String         @db.VarChar(50)
  Remarks           String         @db.VarChar(100)
  MenuPermissions   Json?
  DisplayName       String?
  companyMaster     CompanyMaster? @relation(fields: [CompanyMasterSid], references: [CompanyMasterSid])
  menuMaster        MenuMaster     @relation(fields: [MenuMasterSid], references: [MenuMasterSid])
  roleMaster        RoleMaster     @relation(fields: [RoleMasterSid], references: [RoleMasterSid])
}

model UserType {
  UserTypeSid Int          @id @default(autoincrement()) @map("UserTypeSid")
  name        String       @unique @db.VarChar(50)
  code        UserTypeCode @unique
  createdOn   DateTime     @default(now()) @db.Timestamptz(6)
  updatedOn   DateTime?    @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime?
  status      String?      @default("A") @db.Char(1)
  userMaster  UserMaster[]
}

model RoleMenuHeader {
  RoleMenuHeaderSid Int              @id @default(autoincrement()) @map("RoleMenuHeaderSid")
  RoleMasterSid     Int
  CompanyMasterSid  Int?
  createdOn         DateTime         @default(now()) @db.Timestamptz(6)
  updatedOn         DateTime?        @updatedAt @db.Timestamptz(6)
  createdBy         String           @db.VarChar(100)
  updatedBy         String?          @db.VarChar(100)
  status            String?          @default("A") @db.Char(1)
  Remarks           String           @db.VarChar(100)
  RoleMenuDetail    RoleMenuDetail[]
  RoleMenuPrint     RoleMenuPrint[]
  companyMaster     CompanyMaster?   @relation(fields: [CompanyMasterSid], references: [CompanyMasterSid])
  roleMaster        RoleMaster       @relation(fields: [RoleMasterSid], references: [RoleMasterSid])
}

model RoleMenuDetail {
  RoleMenuDetailSid Int            @id @default(autoincrement()) @map("RoleMenuDetailSid")
  RoleMenuHeaderSid Int
  MenuMasterSid     Int
  DisplayName       String?
  CompanyMasterSid  Int?
  InsertRole        String?        @default("N") @db.Char(1)
  ViewRole          String?        @default("N") @db.Char(1)
  UpdateRole        String?        @default("N") @db.Char(1)
  DeleteRole        String?        @default("N") @db.Char(1)
  PostRole          String?        @default("N") @db.Char(1)
  createdOn         DateTime       @default(now()) @db.Timestamptz(6)
  updatedOn         DateTime?      @updatedAt @db.Timestamptz(6)
  createdBy         String         @db.VarChar(100)
  updatedBy         String?        @db.VarChar(100)
  status            String?        @default("A") @db.Char(1)
  ModuleAndMenus    Json
  companyMaster     CompanyMaster? @relation(fields: [CompanyMasterSid], references: [CompanyMasterSid])
  menuMaster        MenuMaster     @relation(fields: [MenuMasterSid], references: [MenuMasterSid])
  RoleMenuHeader    RoleMenuHeader @relation(fields: [RoleMenuHeaderSid], references: [RoleMenuHeaderSid])
  RoleMenuPrint     RoleMenuPrint[]
  RoleMenuReport    RoleMenuReport[]
}

model RoleMenuPrint {
  RoleMenuPrintSid Int            @id @default(autoincrement()) @map("RoleMenuPrintSid")
  CompanyMasterSid  Int
  RoleMenuHeaderSid Int
  RoleMenuDetailSid Int
  PrintMasterSid    Int
  GiveAccess        String?        @default("N") @db.Char(1)
  CreatedOn         DateTime       @default(now()) @db.Timestamptz(6)
  UpdatedOn         DateTime?      @db.Timestamptz(6)
  CreatedBy         String         @db.VarChar(100)
  UpdatedBy         String?        @db.VarChar(100)
  Status            String?        @default("A") @db.Char(1)

  companyMaster     CompanyMaster  @relation(fields: [CompanyMasterSid], references: [CompanyMasterSid])
  roleMenuHeader    RoleMenuHeader @relation(fields: [RoleMenuHeaderSid], references: [RoleMenuHeaderSid])
  roleMenuDetail    RoleMenuDetail @relation(fields: [RoleMenuDetailSid], references: [RoleMenuDetailSid])
  printMaster       PrintMaster    @relation(fields: [PrintMasterSid], references: [PrintMasterSid])

  @@index([CompanyMasterSid, RoleMenuHeaderSid, RoleMenuDetailSid, PrintMasterSid, Status])
  @@index([CompanyMasterSid, PrintMasterSid])
}

model RoleMenuReport {
  RoleMenuReportSid Int            @id @default(autoincrement()) @map("RoleMenuReportSid")
  RoleMenuDetailSid Int
  ReportMasterSid   Int
  ReportPermission  String?        @default("N") @db.Char(1)
  CreatedOn         DateTime       @default(now()) @db.Timestamptz(6)
  UpdatedOn         DateTime?      @db.Timestamptz(6)
  CreatedBy         String         @db.VarChar(100)
  UpdatedBy         String?        @db.VarChar(100)
  Status            String?        @default("A") @db.Char(1)

  roleMenuDetail    RoleMenuDetail @relation(fields: [RoleMenuDetailSid], references: [RoleMenuDetailSid])
  reportMaster      ReportMaster   @relation(fields: [ReportMasterSid], references: [ReportMasterSid])

  @@index([RoleMenuDetailSid, ReportMasterSid, Status])
  @@index([ReportMasterSid])
}

model PrintMaster {
  PrintMasterSid    Int            @id @default(autoincrement()) @map("PrintMasterSid")
  Name              String         @db.VarChar(50)
  PrintMail         String         @db.VarChar(20)
  MenuMasterSid     Int
  Status            String?        @default("A") @db.Char(1)
  CreatedOn         DateTime       @default(now()) @db.Timestamptz(6)
  UpdatedOn         DateTime?      @db.Timestamptz(6)
  CreatedBy         String         @db.VarChar(100)
  UpdatedBy         String?        @db.VarChar(100)

  MenuMaster        MenuMaster     @relation(fields: [MenuMasterSid], references: [MenuMasterSid])
  RoleMenuPrint     RoleMenuPrint[]

  @@index([MenuMasterSid, Name, Status])
  @@index([PrintMail])
}

enum UserTypeCode {
  admin
  manager
  teamLead
  user
  csPerson
  docPerson
}
