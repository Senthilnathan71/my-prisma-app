model ModuleMaster {
  ModuleMasterSid Int          @id @default(autoincrement()) @map("ModuleMasterSid")
  ModuleName      String       @db.VarChar(20)
  createdOn       DateTime     @default(now()) @db.Timestamptz(6)
  updatedOn       DateTime?    @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime?
  createdBy       String       @db.VarChar(100)
  updatedBy       String?      @db.VarChar(100)
  status          String?      @default("A") @db.Char(1)
  Remarks         String?      @db.VarChar(300)
  ModuleCode      String       @db.VarChar(20)
  icon            String?      @db.VarChar(30)
  menuMaster      MenuMaster[]
}

model UserRoleMaster {
  UserRoleMasterSid Int         @id @default(autoincrement()) @map("UserRoleMasterSid")
  UserMasterSid     Int
  RoleMasterSid     Int
  createdOn         DateTime    @default(now()) @db.Timestamptz(6)
  updatedOn         DateTime?   @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime?
  createdBy         String      @db.VarChar(100)
  updatedBy         String?     @db.VarChar(100)
  status            String?     @default("A") @db.Char(1)
  Remarks           String?     @db.VarChar(300)
  GiveAccess        String?     @default("N") @db.Char(1)
  IsDefault         String?     @default("N") @db.Char(1)
  MenuMasterSid     Int?
  menuMaster        MenuMaster? @relation(fields: [MenuMasterSid], references: [MenuMasterSid])
  roleMaster        RoleMaster  @relation(fields: [RoleMasterSid], references: [RoleMasterSid])
  userMaster        UserMaster  @relation(fields: [UserMasterSid], references: [UserMasterSid])
}

model MenuMaster {
  MenuMasterSid      Int                        @id @default(autoincrement()) @map("MenuMasterSid")
  MenuCode           String                     @db.Char(3)
  MenuName           String                     @db.VarChar(50)
  ModuleMasterSid    Int
  ModuleName         String                     @db.VarChar(50)
  createdOn          DateTime                   @default(now()) @db.Timestamptz(6)
  updatedOn          DateTime?                  @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?
  createdBy          String                     @db.VarChar(100)
  updatedBy          String?                    @db.VarChar(100)
  status             String?                    @default("A") @db.Char(1)
  Remarks            String?                    @db.VarChar(300)
  icon               String?                    @db.VarChar(50)
  path               String?                    @db.VarChar(50)
  parentId           Int?
  authorityMaster    AuthorityMaster[]
  bookingHeader      BookingHeader[]
  costRevenueCharges CostRevenueCharges[]
  customerBrEmail    CustomerBrEmail[]
  enquiryHeader      EnquiryHeader[]
  houseJob           HouseJob[]
  MasterJob          MasterJob[]
  moduleMaster       ModuleMaster               @relation(fields: [ModuleMasterSid], references: [ModuleMasterSid])
  menuPermission     MenuPermission[]
  quoteHeader        QuoteHeader[]
  roleMenuMaster     RoleMenuMaster[]
  terms              TermsAndConditionsMaster[]
  userRoleMaster     UserRoleMaster[]
  menuConfig MenuConfig[]
  ReportMaster ReportMaster[]

}

model MenuPermission {
  MenuPermissionSid Int        @id @default(autoincrement()) @map("MenuPermissionSid")
  MenuMasterSid     Int
  createdOn         DateTime   @default(now()) @db.Timestamptz(6)
  updatedOn         DateTime?  @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime?
  createdBy         String     @db.VarChar(100)
  updatedBy         String?    @db.VarChar(100)
  permissionCode    String?    @db.VarChar(100)
  permissionName    String     @db.VarChar(100)
  status            String?    @default("A") @db.Char(1)
  menuMaster        MenuMaster @relation(fields: [MenuMasterSid], references: [MenuMasterSid])
}

model RoleMaster {
  RoleMasterSid    Int              @id @default(autoincrement()) @map("RoleMasterSid")
  UserRoleCode     String           @db.Char(3)
  UserRoleName     String           @db.VarChar(50)
  CompanyMasterSid Int?
  createdOn        DateTime         @default(now()) @db.Timestamptz(6)
  updatedOn        DateTime?        @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?
  createdBy        String           @db.VarChar(100)
  updatedBy        String?          @db.VarChar(100)
  status           String?          @default("A") @db.Char(1)
  Remarks          String?          @db.VarChar(300)
  LicenseType      String?          @db.VarChar(50)
  companyMaster    CompanyMaster?   @relation(fields: [CompanyMasterSid], references: [CompanyMasterSid])
  roleMenuMaster   RoleMenuMaster[]
  userRoleMaster   UserRoleMaster[]
}

model RoleMenuMaster {
  RoleMenuMasterSid Int            @id @default(autoincrement()) @map("RoleMenuMasterSid")
  RoleMasterSid     Int
  MenuMasterSid     Int
  CompanyMasterSid  Int?
  InsertRole        String?        @default("Y") @db.Char(1)
  ViewRole          String?        @default("Y") @db.Char(1)
  UpdateRole        String?        @default("Y") @db.Char(1)
  DeleteRole        String?        @default("N") @db.Char(1)
  createdOn         DateTime       @default(now()) @db.Timestamptz(6)
  updatedOn         DateTime?      @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime?
  createdBy         String         @db.VarChar(100)
  updatedBy         String?        @db.VarChar(100)
  status            String?        @default("A") @db.Char(1)
  Module            String         @db.VarChar(50)
  Remarks           String         @db.VarChar(100)
  MenuPermissions   Json?
  companyMaster     CompanyMaster? @relation(fields: [CompanyMasterSid], references: [CompanyMasterSid])
  menuMaster        MenuMaster     @relation(fields: [MenuMasterSid], references: [MenuMasterSid])
  roleMaster        RoleMaster     @relation(fields: [RoleMasterSid], references: [RoleMasterSid])
}

model UserType {
  UserTypeSid Int          @id @default(autoincrement()) @map("UserTypeSid")
  name        String       @unique @db.VarChar(50)
  code        UserTypeCode @unique
  createdOn   DateTime     @default(now()) @db.Timestamptz(6)
  updatedOn   DateTime?    @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime?
  status      String?      @default("A") @db.Char(1)
  userMaster  UserMaster[]
}

enum UserTypeCode {
  admin
  manager
  teamLead
  user
  csPerson
  docPerson
}
