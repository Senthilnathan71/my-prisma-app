model NumberSeriesConfig {
  NumberSeriesConfigSid  Int                   @id @default(autoincrement())
  CompanyMasterSid       Int
  BranchMasterSid        Int
  MenuMasterSid          Int
  CompanyFlagRequired    String                @default("N") @db.Char(1)
  CompanyPrefix          String?               @db.VarChar(10)
  BranchFlagRequired     String                @default("N") @db.Char(1)
  BranchPrefix           String?               @db.VarChar(10)
  DepartmentCodeRequired String                @default("N") @db.Char(1)
  MonthFlagRequired      String                @default("N") @db.Char(1)
  YearFlagRequired       String                @default("N") @db.Char(1)
  Separator              String                @default("/") @db.VarChar(5)
  NumberLength           Int                   @default(5)
  ResetOption            String                @default("None") @db.VarChar(10)
  DepartmentWiseCounter  String                @default("N") @db.Char(1)
  CreatedOn              DateTime              @default(now()) @db.Timestamptz(6)
  CreatedBy              String                @db.VarChar(100)
  UpdatedOn              DateTime?             @updatedAt @db.Timestamptz(6)
  UpdatedBy              String?               @db.VarChar(100)
  Status                 String                @default("A") @db.Char(1)
  StartingNumber         Int                   @default(1)
  POLPODFlagRequired     String                @default("N") @db.Char(1)
  POLPODPortWiseCounter  String                @default("N") @db.Char(1)
  OperationCode          String?               @db.VarChar(10)
  OperationFlagRequired  String                @default("N") @db.Char(1)
  POLPODMode             String                @default("BOTH") @db.VarChar(5)
  branchMaster           BranchMaster          @relation(fields: [BranchMasterSid], references: [BranchMasterSid])
  companyMaster          CompanyMaster         @relation(fields: [CompanyMasterSid], references: [CompanyMasterSid])
  menuMaster             MenuMaster            @relation(fields: [MenuMasterSid], references: [MenuMasterSid])
  numberSeriesCounters   NumberSeriesCounter[]

  @@unique([CompanyMasterSid, BranchMasterSid, MenuMasterSid])
  @@index([CompanyMasterSid])
  @@index([BranchMasterSid])
  @@index([MenuMasterSid])
}

model NumberSeriesCounter {
  NumberSeriesCounterSid Int                @id @default(autoincrement())
  NumberSeriesConfigSid  Int
  CompanyMasterSid       Int
  BranchMasterSid        Int
  MenuMasterSid          Int
  DepartmentMasterSid    Int?
  YearMasterSid          Int?
  Month                  Int?
  LastNumber             Int                @default(0)
  CreatedOn              DateTime           @default(now()) @db.Timestamptz(6)
  UpdatedOn              DateTime?          @updatedAt @db.Timestamptz(6)
  PODSid                 Int?
  POLSid                 Int?
  branchMaster           BranchMaster       @relation(fields: [BranchMasterSid], references: [BranchMasterSid])
  companyMaster          CompanyMaster      @relation(fields: [CompanyMasterSid], references: [CompanyMasterSid])
  departmentMaster       DepartmentMaster?  @relation(fields: [DepartmentMasterSid], references: [DepartmentMasterSid])
  menuMaster             MenuMaster         @relation(fields: [MenuMasterSid], references: [MenuMasterSid])
  numberSeriesConfig     NumberSeriesConfig @relation(fields: [NumberSeriesConfigSid], references: [NumberSeriesConfigSid])
  portMasterPOD          PortMaster?        @relation("POD", fields: [PODSid], references: [PortMasterSid])
  portMasterPOL          PortMaster?        @relation("POL", fields: [POLSid], references: [PortMasterSid])
  yearMaster             YearMaster?        @relation(fields: [YearMasterSid], references: [YearMasterSid])

  @@unique([NumberSeriesConfigSid, DepartmentMasterSid, YearMasterSid, Month, POLSid, PODSid])
  @@index([CompanyMasterSid, BranchMasterSid, MenuMasterSid])
  @@index([NumberSeriesConfigSid])
}
