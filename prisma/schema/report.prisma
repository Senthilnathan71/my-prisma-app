model ReportMaster {
  /// Primary Key (uses PostgreSQL sequence `reportmaster_id_seq`)
  ReportMasterSid       Int                  @id @default(autoincrement())
  /// Audit columns
  CreatedOn             DateTime             @default(now())
  CreatedBy             String               @db.VarChar(100)
  UpdatedOn             DateTime             @default(now())
  UpdatedBy             String?              @db.VarChar(100)
  /// Status: e.g. 'A' (Active), 'I' (Inactive)
  Status                String               @default("A") @db.Char(1)
  /// Report meta
  ReportName            String               @db.VarChar(100)
  ReportDisplayName     String               @db.VarChar(100)
  /// Foreign Key to MenuMaster
  ReportMenuSid         Int
  /// Type & Format
  ReportType            String?              @db.VarChar(10)
  ReportFormat          String               @db.Char(5)
  /// Array of company IDs that should not see this report
  Orientation           String               @default("P") @db.Char(1) // P = Portrait, L = Landscape
  ReportExcludedCompany Json?
  menuMaster            MenuMaster           @relation(fields: [ReportMenuSid], references: [MenuMasterSid])
  ReportMasterDetail    ReportMasterDetail[]

  @@index([ReportMenuSid])
  @@index([ReportName])
  @@index([Status])
  @@index([ReportType])
}

model ReportMasterDetail {
  /// Primary Key (PostgreSQL sequence: vouchermatching_id_seq)
  ReportMasterDetailSid Int          @id @default(autoincrement())
  /// Audit columns
  CreatedOn             DateTime     @default(now())
  CreatedBy             String       @db.VarChar(100)
  UpdatedOn             DateTime     @default(now())
  UpdatedBy             String?      @db.VarChar(100)
  /// Status
  Status                String       @default("A") @db.Char(1)
  /// Parameter information
  ParameterName         String       @db.VarChar(20)
  ParameterFieldType    String       @db.VarChar(10)
  /// DropDown values
  DropDownValue         Json?
  /// Optional query to fetch dropdown data dynamically
  ParameterQuery        String?      @db.VarChar(500)
  /// Foreign key to ReportMaster
  ReportMasterSid       Int
  DefaultValue          String?      @db.VarChar(100)
  /// Example: { "required": true, "minLength": 5, "maxLength": 100, "pattern": "^[A-Z]", "min": 0, "max": 100 }
  ValidationRules       Json?
  /// Name of the parent parameter this dropdown depends on (for cascading dropdowns)
  DependsOnParameter    String?      @db.VarChar(50)
  reportMaster          ReportMaster @relation(fields: [ReportMasterSid], references: [ReportMasterSid])

  @@index([ReportMasterSid])
  @@index([Status])
}
