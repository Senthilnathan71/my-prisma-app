model VoucherInterBranch {
  VoucherInterBranchSid Int      @id @default(autoincrement()) @map("VoucherInterBranchSid")
  CreatedOn             DateTime @default(now()) @db.Timestamptz(6)
  CreatedBy             String   @db.VarChar(100)
  UpdatedOn             DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  UpdatedBy             String?  @db.VarChar(100)
  CompanyMasterSid      Int
  BranchMasterSid       Int
  VoucherHeaderSid      Int
  AllotmentBranchSid    Int
  CurrencyAmount        Decimal  @db.Decimal(15, 3)
  LocalAmount           Decimal  @db.Decimal(15, 3)
  SourceJVHeaderSid     Int?
  InterBranchVoucherSid Int?

  company         CompanyMaster  @relation(fields: [CompanyMasterSid], references: [CompanyMasterSid])
  branch          BranchMaster   @relation("VIB_SourceBranch", fields: [BranchMasterSid], references: [BranchMasterSid])
  allotmentBranch BranchMaster   @relation("VIB_AllotmentBranch", fields: [AllotmentBranchSid], references: [BranchMasterSid])
