  CreditNoteReason          String?                     @db.VarChar(100)
  VoucherTypeMasterSid      Int
  VoucherHeaderSid          Int                         @id @default(autoincrement()) @map("VoucherHeaderSid")
  PostStatus                String?                     @default("U") @db.Char(1)
  CashOrBank                String?                     @default("C") @db.Char(1)
  MultiBranch               String?                     @default("N") @db.Char(1)
  BookingHeaderSid          Int?
  Salesman                  String?                     @db.VarChar(30)
  CustomsDuty               String                      @default("N") @db.Char(1)
  BookingRatesCost          BookingRates[]              @relation("COST")
  BookingRatesRevenue       BookingRates[]              @relation("REVENUE")
  CostRevenueChargesCost    CostRevenueCharges[]        @relation("COST")
  CostRevenueChargesRevenue CostRevenueCharges[]        @relation("REVENUE")
  exchangeJVLinks           VoucherMatchingExchangeJV[] @relation("ExchangeJVLink")
  SourceMatchingDetail      MatchingDetail[]            @relation("SourceVoucherHeader")
  MatchingDetail            MatchingDetail[]            @relation("VoucherHeader")
  VoucherDetail             VoucherDetail[]
  BookingHeader             BookingHeader?              @relation(fields: [BookingHeaderSid], references: [BookingHeaderSid])
  BranchMaster              BranchMaster                @relation(fields: [BranchMasterSid], references: [BranchMasterSid])
  coaMaster                 COAMaster?                  @relation(fields: [COAMasterSid], references: [COAMasterSid])
  CompanyMaster             CompanyMaster               @relation(fields: [CompanyMasterSid], references: [CompanyMasterSid])
  currencyMaster            CurrencyMaster?             @relation("PartyCurrency", fields: [CurrencyMasterSid], references: [CurrencyMasterSid])
  bankCurrencyMaster        CurrencyMaster?             @relation("BankCurrency", fields: [BankCurrencyMasterSid], references: [CurrencyMasterSid])
  customerBranch            CustomerBranch?             @relation(fields: [CustomerBranchSid], references: [CustomerBranchSid])
  departmentMaster          DepartmentMaster?           @relation(fields: [DepartmentMasterSid], references: [DepartmentMasterSid])
  houseJob                  HouseJob?                   @relation(fields: [HouseJobSid], references: [HouseJobSid])
  masterJob                 MasterJob?                  @relation(fields: [MasterJobSid], references: [MasterJobSid])
  subledgerMaster           SubledgerMaster?            @relation(fields: [PartyMasterSid], references: [SubledgerMasterSid])
  voucherTypeMaster         VoucherTypeMaster           @relation(fields: [VoucherTypeMasterSid], references: [VoucherTypeMasterSid])
  voucherMatchings          VoucherMatching[]
  voucherMatchingHeader     VoucherMatchingHeader[]
  VoucherOthers             VoucherOthers[]
  VoucherTDS                VoucherTDS[]
  VoucherTransaction        VoucherTransaction[]
  interBranchSource         VoucherInterBranch[]        @relation("VIB_Source")
  interBranchSourceJV       VoucherInterBranch[]        @relation("VIB_SourceJV")
  interBranchMirrorJV       VoucherInterBranch[]        @relation("VIB_MirrorJV")

  @@unique([CompanyMasterSid, VoucherNumber], name: "uq_voucher_company")
}

