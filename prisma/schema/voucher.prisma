  InvoiceType               String?                     @db.VarChar(10)
  ReversalVoucher           Int?
  TaxNumber                 Int?
  GSTType                   String?                     @db.VarChar(10)
  Remarks                   String?                     @db.VarChar(300)
  DepartmentMasterSid       Int?
  HouseNumber               String?                     @db.VarChar(50)
  MasterNumber              String?                     @db.VarChar(50)
  HouseJobSid               Int?
  MasterJobSid              Int?
  CurrencyMasterSid         Int?
  CurrencyCode              String?                     @db.Char(3)
  BankCurrencyMasterSid     Int?
  BankCurrencyCode          String?                     @db.Char(3)
  ExchangeRate              Decimal?                    @db.Decimal(8, 5)
  Amount                    Decimal?                    @db.Decimal(15, 3)
  LocalAmount               Decimal?                    @db.Decimal(15, 3)
  NetAmount                 Decimal?                    @db.Decimal(15, 3)
  DocumentNumber            String?                     @db.VarChar(30)
  DocumentDate              DateTime?                   @db.Date
  SetoffStatus              String?                     @db.VarChar(15)
  TaxType                   String?                     @db.Char(3)
  InstrumentMode            String?                     @db.VarChar(10)
  InstrumentNumber          String?                     @db.VarChar(25)
  InstrumentDate            DateTime?                   @db.Date
